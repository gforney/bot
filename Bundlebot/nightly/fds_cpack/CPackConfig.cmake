set(CPACK_GENERATOR NSIS)
set(CPACK_PACKAGE_NAME "FDS and Smokeview")
set(CPACK_PACKAGE_VENDOR "firemodels")
set(CPACK_PACKAGE_VERSION "6")
set(CPACK_PACKAGE_FILE_NAME "$ENV{basename}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "firemodels")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "$ENV{fds_version} and $ENV{smv_version}")
set(CPACK_PACKAGE_DESCRIPTION_FILE "${CMAKE_CURRENT_LIST_DIR}/description.txt")
set(CPACK_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/../../release/smv_cpack")
set(CPACK_FDS_SETUP_DEFINE "!define FDS_BUNDLE")

file(TO_CMAKE_PATH "$ENV{out_bundle}" payload)
foreach(required IN ITEMS setup.bat FDS6/bin/fds.exe SMV6/smokeview.exe)
  if(NOT EXISTS "${payload}/${required}")
    message(FATAL_ERROR "Incomplete FDS and Smokeview payload: ${payload}/${required}")
  endif()
endforeach()
set(CPACK_INSTALLED_DIRECTORIES "${payload};/firemodels")
