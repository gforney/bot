set(CPACK_GENERATOR NSIS)
set(CPACK_PACKAGE_NAME "Smokeview")
set(CPACK_PACKAGE_VENDOR "firemodels")
set(CPACK_PACKAGE_VERSION "6")
set(CPACK_PACKAGE_FILE_NAME "$ENV{zipbase}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "firemodels")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Smokeview $ENV{versionbase}")
set(CPACK_PACKAGE_DESCRIPTION_FILE "${CMAKE_CURRENT_LIST_DIR}/description.txt")
set(CPACK_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
file(TO_CMAKE_PATH "$ENV{bundles}/$ENV{smvdir}" payload)
if(NOT EXISTS "${payload}/smokeview.exe" OR NOT EXISTS "${payload}/set_path.bat")
  message(FATAL_ERROR "Incomplete Smokeview installer payload: ${payload}")
endif()
set(CPACK_INSTALLED_DIRECTORIES "${payload};/SMV6")
